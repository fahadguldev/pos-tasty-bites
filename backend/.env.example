# copy this file to .env and fill in the blanks

# --- server ---
PORT=4000
# comma separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# --- database ---
MONGODB_URI=mongodb://127.0.0.1:27017/tasty_bites

# --- auth ---
# generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# first admin account, created automatically on first boot
ADMIN_EMAIL=admin@tastybites.pk
ADMIN_PASSWORD=tastybites123
ADMIN_NAME=Owner

# --- Cloudinary (product images) ---
# free account at https://cloudinary.com, keys live in the dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp Cloud API (optional) ---
# without these the orders page falls back to a tap-to-send wa.me link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
