# copy this file to .env and fill in the blanks

# --- server ---
# Vercel sets PORT itself, so this only matters when you run the app locally.
PORT=4000
# comma separated list of origins allowed to call this API.
# On Vercel set this to your production domain (e.g. https://tasty-bites.vercel.app).
# Browsers send an Origin header even on same-origin POSTs, so a request that is
# missing from this list is rejected with 403.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# --- database ---
# Required in production. If this is empty the app falls back to a throwaway
# in-memory MongoDB whose data is lost on every cold start, and a real hosted
# database (e.g. MongoDB Atlas) is what you want here.
MONGODB_URI=mongodb://127.0.0.1:27017/tasty_bites

# --- auth ---
# generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# first admin account, created automatically on first boot
ADMIN_EMAIL=admin@tastybites.pk
ADMIN_PASSWORD=tastybites123
ADMIN_NAME=Owner

# --- Cloudinary (product images) ---
# free account at https://cloudinary.com, keys live in the dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp (open-wa, optional) ---
# The campaign page is useless without this, and the API runs fine without it.
# Only the worker process sends; the API server never does.
#
#   WHATSAPP_TRANSPORT=openwa
#   WHATSAPP_SEND_ENABLED=true
#
# WHATSAPP_SEND_ENABLED is a second switch on purpose. Setting the transport is
# easy to do by accident; sending from a real number is not.
WHATSAPP_TRANSPORT=
WHATSAPP_SEND_ENABLED=false

# --- WhatsApp Cloud API (optional) ---
# without these the orders page falls back to a tap-to-send wa.me link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- WhatsApp worker settings (optional) ---
# name for the saved sign-in. each name keeps its own signed-in session.
WHATSAPP_SESSION_ID=tasty-bites
# where the signed-in session is kept. relative to the backend folder.
# do not commit this, and do not delete it unless you want to scan again.
WHATSAPP_SESSION_PATH=./.broadcast-session
# leave the browser window visible if you want to watch it work
WHATSAPP_HEADLESS=true
# how long to keep showing the QR code before giving up
WHATSAPP_LOGIN_TIMEOUT_MS=300000
# how often to look for queued messages when there is nothing to send
WHATSAPP_WORKER_INTERVAL_MS=5000
# only needed if Chrome is installed somewhere unusual
WHATSAPP_CHROME_PATH=
# only needed on a server with no residential connection of its own
# keeps the IP steady, which matters more than anything else for a new number
WHATSAPP_PROXY=
# extra logging from the whatsapp client while you are setting it up
WHATSAPP_DEBUG=false
