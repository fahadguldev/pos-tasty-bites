# copy this file to .env.local

# optional. Leave it unset to call /api on the same origin, which is what the
# Vercel deployment does — frontend and backend share one domain. Only set it
# when the API lives somewhere else, e.g. pointing the dev server at another host.
#
# `npm run dev` already proxies /api to http://localhost:4000, so you do not
# need this for local development either.
#
# Vite inlines this at build time, so a change needs a rebuild.
# VITE_API_URL=https://api.example.com/api
